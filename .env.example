# Copier ce fichier en `.env` et renseigner les valeurs. Ne JAMAIS commiter `.env`.

# Jeton du bot Discord (portail développeur Discord)
DISCORD_TOKEN=votre_token_discord_ici

# Identifiants MongoDB (aussi utilisés pour créer l'utilisateur root du Mongo fourni par docker-compose)
MONGODB_USER=admin
MONGODB_PASSWORD=un_mot_de_passe_fort_ici

# --- Activité Discord (optionnel, cf. docs/activity/ARCHITECTURE.md) ---
# ACTIVITY_ENABLED=true
# ACTIVITY_BIND=127.0.0.1:8787
# ACTIVITY_STATIC_DIR=web/activity/dist
# ACTIVITY_SESSION_TTL_SECS=3600
# DISCORD_CLIENT_ID=identifiant_de_l_application
# DISCORD_CLIENT_SECRET=secret_oauth2_ne_jamais_commiter

# Optionnel — valeurs par défaut entre parenthèses
# MONGODB_HOST=mongo          (docker-compose) / 127.0.0.1 (lancement local)
# MONGODB_PORT=27017
# MONGODB_AUTH_SOURCE=admin
